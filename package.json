{
  "name": "reylo",
  "version": "0.6.0",
  "private": true,
  "description": "Import SQL files as fully typed queries. A TypeScript content mapper plus a runtime loader.",
  "license": "MIT",
  "author": "Colin McDonnell",
  "homepage": "https://reylo.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/colinhacks/reylo.git"
  },
  "bugs": "https://github.com/colinhacks/reylo/issues",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "bin": {
    "reylo": "./src/cli.ts"
  },
  "exports": {
    ".": "./src/index.ts",
    "./register": "./src/register.ts",
    "./vite": "./src/vite.ts",
    "./esbuild": "./src/esbuild.ts",
    "./webpack": "./src/webpack.ts",
    "./turbopack": "./src/turbopack.ts",
    "./next": "./src/next.ts",
    "./jest": "./src/jest.ts"
  },
  "typescript": {
    "contentMapper": {
      "exec": [
        "node",
        "src/mapper.ts"
      ],
      "compilerOptions": [],
      "dynamicConfig": true
    }
  },
  "scripts": {
    "build": "nub scripts/build.ts",
    "typecheck": "tsc --noEmit --runExternalCode",
    "test": "node --test 'tests/**/*.test.ts'"
  },
  "devDependencies": {
    "@bytecodealliance/jco": "1.39.0",
    "@bytecodealliance/preview2-shim": "0.30.0",
    "@reylosql/mysql": "link:packages/mysql",
    "@reylosql/postgres": "link:packages/postgres",
    "@reylosql/sqlite": "link:packages/sqlite",
    "@types/node": "^26.6.1",
    "esbuild": "^0.28.2",
    "slonik": "49.12.0",
    "typescript": "^7.1.0-dev.20260918.1"
  },
  "peerDependencies": {
    "@reylosql/mysql": "0.6.0",
    "@reylosql/postgres": "0.6.0",
    "@reylosql/sqlite": "0.6.0",
    "slonik": ">=49.12.0"
  },
  "peerDependenciesMeta": {
    "@reylosql/mysql": { "optional": true },
    "@reylosql/postgres": { "optional": true },
    "@reylosql/sqlite": { "optional": true },
    "slonik": { "optional": true }
  }
}
