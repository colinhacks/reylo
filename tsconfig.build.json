{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "allowImportingTsExtensions": false,
    "declaration": true,
    "rootDir": ".",
    "outDir": "dist/reylo"
  },
  // reylo's own package: the run time and the entry points a project names, which load the
  // build-time half from the engine package (src/engine-package.ts). The worker is started by its
  // URL, so it is named here; the rest are what these import. `include` is emptied, since it would
  // otherwise come from tsconfig.json.
  "include": [],
  "files": ["src/index.ts", "src/register.ts", "src/register-worker.ts", "src/vite.ts", "src/esbuild.ts", "src/webpack.ts", "src/turbopack.ts", "src/next.ts", "src/jest.ts", "src/mapper.ts", "src/cli.ts"]
}
