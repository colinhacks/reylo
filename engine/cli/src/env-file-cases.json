[
  { "case": "a comment after a quoted value", "env": "DATABASE_URL=\"file:./app.db\" # local development\n", "vars": { "DATABASE_URL": "file:./app.db" } },
  { "case": "a comment after an unquoted value", "env": "DATABASE_URL=file:./app.db # local development\n", "vars": { "DATABASE_URL": "file:./app.db" } },
  { "case": "a comment after a tab", "env": "A=x\t# c", "vars": { "A": "x" } },
  { "case": "a # inside double quotes", "env": "DATABASE_URL=\"postgres://u:p#w@h/db\"", "vars": { "DATABASE_URL": "postgres://u:p#w@h/db" } },
  { "case": "a # inside single quotes, then a comment", "env": "A='p#w' # c", "vars": { "A": "p#w" } },
  { "case": "a # inside back quotes, then a comment", "env": "A=`p#w` # c", "vars": { "A": "p#w" } },
  { "case": "an unquoted # starts a comment, with no space before it", "env": "DATABASE_URL=postgres://u:p#w@h/db", "vars": { "DATABASE_URL": "postgres://u:p" } },
  { "case": "comment lines and blank lines", "env": "# A=1\n\n   # B=2\n\t\nC=3\n", "vars": { "C": "3" } },
  { "case": "export", "env": "export A=1\nexport\tB=2\nexport=3\n", "vars": { "A": "1", "B": "2", "export": "3" } },
  { "case": "spaces around the name and the value", "env": "   A  =  b c  \n", "vars": { "A": "b c" } },
  { "case": "empty values", "env": "A=\nB= \nC= # c\nD=\"\"\nE=", "vars": { "A": "", "B": "", "C": "", "D": "", "E": "" } },
  { "case": "Windows line endings", "env": "A=1\r\nB=\"2\"\r\nC='3' # c\r\n", "vars": { "A": "1", "B": "2", "C": "3" } },
  { "case": "old Mac line endings", "env": "A=1\rB=2\r", "vars": { "A": "1", "B": "2" } },
  { "case": "a byte order mark", "env": "﻿A=1\n", "vars": { "A": "1" } },
  { "case": "an = in a value", "env": "A=x=y\nB=\"x=y\"\n", "vars": { "A": "x=y", "B": "x=y" } },
  { "case": "a double-quoted value over lines, and \\n in it", "env": "KEY=\"line 1\nline 2\\nline 3\"\nB=2\n", "vars": { "KEY": "line 1\nline 2\nline 3", "B": "2" } },
  { "case": "\\n in single and back quotes is kept", "env": "A='a\\nb'\nB=`a\\nb`\n", "vars": { "A": "a\\nb", "B": "a\\nb" } },
  { "case": "text after the closing quote", "env": "A=\"abc\" def\nB=2\n", "vars": { "A": "abc", "B": "2" } },
  { "case": "a quote that never closes is read as unquoted", "env": "A=\"abc # c\nB=2\n", "vars": { "A": "\"abc", "B": "2" } },
  { "case": "a quote inside an unquoted value", "env": "A=it's\n", "vars": { "A": "it's" } },
  { "case": "names that are not variable names", "env": "1A=1\nA-B=2\nA B=3\n=4\nC=5\n", "vars": { "C": "5" } },
  { "case": "a line with no =", "env": "JUST_A_NAME\nB=2\n", "vars": { "B": "2" } },
  { "case": "the last line that sets a variable wins", "env": "A=1\nA=2\n", "vars": { "A": "2" } },
  { "case": "${…} and $(…) are kept as written", "env": "A=${B}x\nC=$(touch pwned)\n", "vars": { "A": "${B}x", "C": "$(touch pwned)" } }
]
