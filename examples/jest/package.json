{
  "name": "reylo-example-jest",
  "private": true,
  "type": "module",
  "scripts": {
    "setup": "node --env-file-if-exists=.env setup.ts",
    "typecheck": "tsc --noEmit --runExternalCode",
    "test": "node --env-file-if-exists=.env --experimental-vm-modules node_modules/jest/bin/jest.js",
    "test:cjs": "node --env-file-if-exists=.env node_modules/jest/bin/jest.js --config jest.cjs.config.js"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "reylo": "link:../../dist/reylo"
  },
  "devDependencies": {
    "@babel/core": "^8.0.7",
    "@babel/preset-env": "^8.0.7",
    "@babel/preset-typescript": "^8.0.7",
    "@jest/globals": "^30.5.2",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.5",
    "babel-jest": "^30.5.2",
    "jest": "^30.5.2",
    "typescript": "7.1.0-beta"
  }
}
