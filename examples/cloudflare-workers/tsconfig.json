{
  "compilerOptions": {
    "target": "esnext",
    "module": "esnext",
    "moduleResolution": "bundler",
    "lib": ["esnext"],
    "types": ["@cloudflare/workers-types", "@cloudflare/vitest-plugin/types", "node"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true
  },
  "contentMappers": [
    { "package": "reylo", "extensions": [".sql", ".reylo.yaml"] }
  ],
  "include": ["src", "test", "vite.config.ts", "vitest.config.ts", "setup.ts"]
}
