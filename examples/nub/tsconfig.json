{
  "compilerOptions": {
    "target": "esnext",
    "module": "nodenext",
    "lib": ["esnext"],
    "types": ["node"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true
  },
  "contentMappers": [
    {
      "package": "reylo",
      "extensions": [".sql", ".reylo.yaml"]
    }
  ],
  "include": ["src", "setup.ts"],
  "exclude": ["node_modules"]
}
