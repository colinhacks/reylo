{
  "name": "reylo-example-webpack",
  "private": true,
  "type": "module",
  "scripts": {
    "setup": "node --env-file-if-exists=.env setup.ts",
    "typecheck": "tsc --noEmit --runExternalCode",
    "dev": "node --watch --env-file-if-exists=.env --import reylo/register src/server.ts",
    "build": "webpack",
    "watch": "webpack --watch",
    "start": "node --env-file-if-exists=.env dist/server.mjs"
  },
  "dependencies": {
    "mysql2": "^3.24.6",
    "reylo": "link:../../dist/reylo"
  },
  "devDependencies": {
    "@swc/core": "^1.16.18",
    "@types/node": "^24.0.0",
    "swc-loader": "^0.2.7",
    "typescript": "7.1.0-beta",
    "webpack": "^5.112.0",
    "webpack-cli": "^7.2.3"
  }
}
